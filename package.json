{
  "name": "restaurant-management-system",
  "version": "1.0.0",
  "description": "Full-stack Restaurant Management System (MERN)",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:customer-mobile": "npm run start --prefix customer-mobile",
    "install:all": "npm install --prefix server && npm install --prefix client && npm install --prefix customer-mobile",
    "build:client": "npm run build --prefix client",
    "start": "npm run start --prefix server"
  }
}
