# API proxy uses Vite's same-origin /api proxy in dev
# Set to http://YOUR-IP:5000/api to bypass proxy
VITE_API_URL=/api

# Socket.IO server URL - auto-configured per environment
# Empty = http://localhost:5000 in dev, same-origin in production  
# Set to http://YOUR-IP:5000 for different backend
VITE_SOCKET_URL=
